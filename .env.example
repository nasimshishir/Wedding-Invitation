# Paste your deployed Google Apps Script Web App URL here to sync guests & RSVPs with Google Sheets.
# Leave empty to run in local file mode (data/guests.json) for development & testing.
GOOGLE_SCRIPT_URL=

# Passcode for accessing the /dashboard host portal (defaults to "nikah2026" if unset in local mode)
HOST_PASSCODE=nikah2026

# Your live site URL (e.g. https://your-wedding.vercel.app) used for Open Graph previews & invite links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
