# Dual Google Spreadsheets (one for Groom's side, one for Bride's side).
# Each spreadsheet has 2 sheets: "Guest List" and "Respond List".
# Leave empty to run in local demo mode (data/guests.json).
GOOGLE_SCRIPT_URL_GROOM=
GOOGLE_SCRIPT_URL_BRIDE=

# Optional single-spreadsheet fallback (only used if the two above are empty)
GOOGLE_SCRIPT_URL=

# Two separate passcodes for /dashboard so each side sees & adds its own guests
GROOM_PASSCODE=groom2026
BRIDE_PASSCODE=bride2026

# Optional master passcode to view & manage both sides together
HOST_PASSCODE=nikah2026

# Your live site URL (e.g. https://sagor-and-moon.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
